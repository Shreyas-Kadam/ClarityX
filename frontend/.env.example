# ClarityX Frontend Environment Configuration
# Copy this file to .env and provide your actual Supabase project credentials.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (safe to use in frontend client)
# NEVER put SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# ClarityX FastAPI Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000